    "The scale can't be empty and must be a number greater than 0." : {
      "comment" : "Alerts – Messages",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nota máxima no puede estar vacía y debe ser un número mayor que 0."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le barème ne peut pas être vide et doit être un nombre supérieur à 0."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il voto massimo non può essere vuoto e deve essere un numero maggiore di 0."
          }
        }
      }
    },
    "The value can't be empty and must be a number between 0 and" : {
      "comment" : "Alerts – Messages",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El valor no puede estar vacío y debe ser un número entre 0 y"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La valeur ne peut pas être vide et doit être un nombre compris entre 0 et"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il valore non può essere vuoto e deve essere un numero compreso tra 0 e"
          }
        }
      }
    },
    "Unknown error." : {
